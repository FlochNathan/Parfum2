using System;
using System.Net.Http;
using System.Net.Http.Headers;
using System.Text.Json;
using System.Threading;
using System.Threading.Tasks;
using Android.App;
using Android.Content;
using Android.OS;
using Android.Widget;
using Android.Media;
using Android.Net;
using System.IO;
using SysUri = System.Uri;

namespace Read_Andro
{
    [Service]
    public class MyForegroundService : Service
    {
        CancellationTokenSource? _cts;
        HttpClient _http = new HttpClient();
        string _lastCommand = string.Empty;
        string? _botUserId;
        string? _lastDiscordMessageId;

        public override void OnCreate()
        {
            base.OnCreate();
            CreateNotificationChannel();
            var notification = BuildNotification("Service démarré");
            StartForeground(1001, notification);
        }

        public override StartCommandResult OnStartCommand(Intent? intent, StartCommandFlags flags, int startId)
        {
            _cts = new CancellationTokenSource();
            Task.Run(() => RunAsync(_cts.Token));
            return StartCommandResult.Sticky;
        }

        public override void OnDestroy()
        {
            _cts?.Cancel();
            _http.Dispose();
            base.OnDestroy();
        }

        public override IBinder? OnBind(Intent? intent) => null;

        async Task RunAsync(CancellationToken token)
        {
            var prefs = Application.Context.GetSharedPreferences("ReadAndroPrefs", FileCreationMode.Private);

            var defaultToken = "BOT_TOKEN_HERE";
            var defaultChannel = "CHANNEL_ID_HERE";
            var botToken = prefs.GetString("discord_token", defaultToken) ?? defaultToken;
            var channelId = prefs.GetString("discord_channel", defaultChannel) ?? defaultChannel;

            var useDiscord = !string.IsNullOrEmpty(botToken) && botToken != "BOT_TOKEN_HERE" &&
                             !string.IsNullOrEmpty(channelId) && channelId != "CHANNEL_ID_HERE";

            if (useDiscord)
            {
                try
                {
                    _http.DefaultRequestHeaders.Authorization = new AuthenticationHeaderValue("Bot", botToken);
                    await InitializeDiscordAsync(token);
                }
                catch { }
            }

            while (!token.IsCancellationRequested)
            {
                try
                {
                    if (useDiscord)
                    {
                        await PollDiscordChannelAsync(channelId, token);
                    }
                    else
                    {
                        // optional fallback: if a command_url is stored in preferences, use it
                        var commandUrl = prefs.GetString("command_url", null);
                        if (!string.IsNullOrEmpty(commandUrl))
                        {
                            var resp = await _http.GetAsync(commandUrl, token);
                            if (resp.IsSuccessStatusCode)
                            {
                                var txt = await resp.Content.ReadAsStringAsync(token);
                                using var doc = JsonDocument.Parse(txt);
                                if (doc.RootElement.TryGetProperty("command", out var cmdEl))
                                {
                                    var cmd = cmdEl.GetString() ?? string.Empty;
                                    if (!string.IsNullOrEmpty(cmd) && cmd != _lastCommand)
                                    {
                                        _lastCommand = cmd;
                                        HandleCommand(cmd);
                                    }
                                }
                            }
                        }
                    }
                }
                catch (global::System.OperationCanceledException) { break; }
                catch (Exception ex)
                {
                }

                await Task.Delay(TimeSpan.FromSeconds(5), token);
            }
        }

        async Task InitializeDiscordAsync(CancellationToken token)
        {
            try
            {
                var resp = await _http.GetAsync("https://discord.com/api/v10/users/@me", token);
                if (!resp.IsSuccessStatusCode) return;
                var txt = await resp.Content.ReadAsStringAsync(token);
                using var doc = JsonDocument.Parse(txt);
                if (doc.RootElement.TryGetProperty("id", out var idEl))
                {
                    _botUserId = idEl.GetString();
                }
            }
            catch { }
        }

        async Task PollDiscordChannelAsync(string channelId, CancellationToken token)
        {
            if (string.IsNullOrEmpty(channelId)) return;
            var url = $"https://discord.com/api/v10/channels/{channelId}/messages?limit=1";
            var resp = await _http.GetAsync(url, token);
            if (!resp.IsSuccessStatusCode) return;
            var txt = await resp.Content.ReadAsStringAsync(token);
            using var doc = JsonDocument.Parse(txt);
            if (doc.RootElement.ValueKind != JsonValueKind.Array) return;
            if (doc.RootElement.GetArrayLength() == 0) return;
            var msg = doc.RootElement[0];
            var msgId = msg.GetProperty("id").GetString() ?? string.Empty;
            var content = msg.GetProperty("content").GetString() ?? string.Empty;
            var authorId = msg.GetProperty("author").GetProperty("id").GetString() ?? string.Empty;

            if (!string.IsNullOrEmpty(_botUserId) && authorId == _botUserId) return;

            if (msgId != _lastDiscordMessageId)
            {
                _lastDiscordMessageId = msgId;
                // simple commands: exact match or starts with '!'
                var cmd = content.Trim();
                if (cmd.StartsWith("!")) cmd = cmd.Substring(1).Trim();
                HandleCommand(cmd);
            }
        }

        void HandleCommand(string rawCmd)
        {
            var full = rawCmd?.Trim() ?? string.Empty;
            if (string.IsNullOrEmpty(full)) return;

            // split command and args
            var parts = full.Split(new[] { ' ' }, 2, StringSplitOptions.RemoveEmptyEntries);
            var cmd = parts.Length > 0 ? parts[0].ToLowerInvariant() : string.Empty;
            var arg = parts.Length > 1 ? parts[1] : string.Empty;

            switch (cmd)
            {
                case "vibrate":
                    // optional argument in ms
                    if (int.TryParse(arg, out var ms)) VibrateMs(ms); else TryVibrate();
                    ShowNotification("Commande reçue", "Vibration exécutée");
                    break;
                case "toast":
                    var toastMsg = string.IsNullOrEmpty(arg) ? "Commande toast reçue" : arg;
                    ShowToast(toastMsg);
                    ShowNotification("Toast", toastMsg);
                    break;
                case "notify":
                    // syntax: notify Title|Body  (use '|' to separate)
                    var title = Application.Context.GetString(Resource.String.app_name);
                    var body = arg;
                    if (!string.IsNullOrEmpty(arg))
                    {
                        var idx = arg.IndexOf('|');
                        if (idx >= 0)
                        {
                            title = arg.Substring(0, idx).Trim();
                            body = arg.Substring(idx + 1).Trim();
                        }
                    }
                    ShowNotification(title, string.IsNullOrEmpty(body) ? "" : body);
                    break;
                case "openurl":
                if (!string.IsNullOrEmpty(arg))
                    {
                        try
                        {
                            var uri = Android.Net.Uri.Parse(arg);
                            var intent = new Intent(Intent.ActionView, uri);
                            intent.AddFlags(ActivityFlags.NewTask);
                            StartActivity(intent);
                            ShowNotification("Open URL", arg);
                        }
                        catch { ShowNotification("Open URL", "URL invalide"); }
                    }
                    break;
                case "beep":
                    PlayBeep();
                    ShowNotification("Beep", "Son joué");
                    break;
                case "setpref":
                    // setpref key value
                    {
                        var kv = arg.Split(new[] { ' ' }, 2, StringSplitOptions.RemoveEmptyEntries);
                        if (kv.Length == 2)
                        {
                            var prefs = Application.Context.GetSharedPreferences("ReadAndroPrefs", FileCreationMode.Private);
                            var editor = prefs.Edit();
                            editor.PutString(kv[0], kv[1]);
                            editor.Commit();
                            ShowNotification("Pref sauvegardée", kv[0]);
                        }
                    }
                    break;
                case "getpref":
                    // getpref key
                    if (!string.IsNullOrEmpty(arg))
                    {
                        var prefs = Application.Context.GetSharedPreferences("ReadAndroPrefs", FileCreationMode.Private);
                        var val = prefs.GetString(arg, "(null)") ?? "(null)";
                        ShowNotification($"Pref {arg}", val);
                    }
                    break;
                default:
                    ShowNotification("Commande inconnue", full);
                    break;
            }
        }

        void VibrateMs(int ms)
        {
            try
            {
                if (ms <= 0) ms = 500;
                var vib = (Vibrator?)GetSystemService(VibratorService);
                if (vib == null) return;
                if (Build.VERSION.SdkInt >= BuildVersionCodes.O)
                    vib.Vibrate(VibrationEffect.CreateOneShot(ms, VibrationEffect.DefaultAmplitude));
                else
                    vib.Vibrate(ms);
            }
            catch { }
        }

        void PlayBeep()
        {
            try
            {
                using var tg = new ToneGenerator(Android.Media.Stream.Notification, 100);
                tg.StartTone(Tone.PropBeep, 200);
            }
            catch { }
        }

        void TryVibrate()
        {
            try
            {
                var vib = (Vibrator?)GetSystemService(VibratorService);
                if (vib == null) return;

                if (Build.VERSION.SdkInt >= BuildVersionCodes.O)
                {
                    vib.Vibrate(VibrationEffect.CreateOneShot(500, VibrationEffect.DefaultAmplitude));
                }
                else
                {
                    vib.Vibrate(500);
                }
            }
            catch { }
        }
  
        void ShowToast(string message)
        {
            try
            {
                var handler = new Android.OS.Handler(Looper.MainLooper);
                handler.Post(() => Toast.MakeText(Application.Context, message, ToastLength.Short).Show());
            }
            catch { }
        }

        void ShowNotification(string title, string text)
        {
            var nm = (NotificationManager)GetSystemService(NotificationService);
            var builder = BuildNotificationBuilder(title, text);
            nm.Notify(new Random().Next(), builder.Build());
        }

        Notification BuildNotification(string text)
        {
            var builder = BuildNotificationBuilder(Application.Context.GetString(Resource.String.app_name), text);
            return builder.Build();
        }
      

        Notification.Builder BuildNotificationBuilder(string title, string text)
        {
            var channelId = "read_andro_channel";
            Notification.Builder builder;
            if (Build.VERSION.SdkInt >= BuildVersionCodes.O)
            {
                builder = new Notification.Builder(this, channelId);
            }
            else
            {
                builder = new Notification.Builder(this);
            }

            builder.SetContentTitle(title)
                   .SetContentText(text)
                   .SetSmallIcon(Resource.Mipmap.appicon)
                   .SetOngoing(true);
            return builder;
        }

        void CreateNotificationChannel()
        {
            if (Build.VERSION.SdkInt < BuildVersionCodes.O) return;
            var channelId = "read_andro_channel";
            var channelName = "ReadAndro service";
            var nm = (NotificationManager)GetSystemService(NotificationService);
            var channel = nm.GetNotificationChannel(channelId);
            if (channel == null)
            {
                channel = new NotificationChannel(channelId, channelName, NotificationImportance.Default);
                nm.CreateNotificationChannel(channel);
            }
        }
    }
}
